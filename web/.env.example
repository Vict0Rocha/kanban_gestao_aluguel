# Copie este arquivo para .env.local e preencha com os valores do seu
# projeto Supabase (Project Settings > API no painel do Supabase).
# NEXT_PUBLIC_* fica exposto no navegador — é feito para isso, a anon key
# é segura de expor (o acesso real é controlado pelas políticas de RLS).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional — desafio anti-bot da Cloudflare na tela de login.
# Deixe em branco e o login funciona sem desafio; preencha para ativar.
# A site key é pública (vai no bundle, é o par público do segredo).
# A SECRET key NÃO vem para cá: ela é configurada no painel do Supabase,
# em Authentication > Attack Protection > CAPTCHA protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
